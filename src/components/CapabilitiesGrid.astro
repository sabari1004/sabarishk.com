---
import { 
  Smartphone, 
  Database, 
  MapPin, 
  RefreshCw, 
  ArrowRight
} from 'lucide-astro';

export interface CapabilityItem {
  id: string;
  icon: typeof Smartphone;
  title: string;
  domain: string;
  focus: string;
  techStack: string[];
  highlights: string[];
}

const capabilities: CapabilityItem[] = [
  {
    id: 'ssam-mdk-architecture',
    icon: Smartphone,
    title: 'SAP Service & Asset Manager (SSAM) & MDK Architecture',
    domain: 'Enterprise Mobility & Field Workforce',
    focus: 'Greenfield SSAM deployments, multi-version upgrades (2105 -> 2210 -> 2410 -> 2505), custom MDK client branding (APK/IPA builds), offline store performance tuning, and Mobile Services on BTP Cloud Foundry/Neo.',
    techStack: ['SSAM 2505', 'MDK', 'SAP BTP Mobile Services', 'Offline OData', 'SQLite', 'iOS/Android'],
    highlights: [
      'Architected Greenfield rollouts and multi-version upgrades (2105 -> 2210 -> 2410 -> 2505) for Tier-1 US utilities',
      'Configured custom branded MDK Native client APK/IPA containers with zero-trust MDM & Intune profiles',
      'Engineered offline store performance tuning, reducing initial synchronization latency by 65%',
    ],
  },
  {
    id: 's4hana-backend-integration',
    icon: Database,
    title: 'S/4HANA Core & Backend Integration (ABAP / MAIF)',
    domain: 'Core ERP & Asset Management',
    focus: 'Deep backend integration across SAP PM, WCM (Isolation/Normalization), PS (Network/Activity), and IS-Utilities. Custom BAPIs, BAdIs, User Exits, OData provisioning via SEGW/CAP, and Mobile Application Integration Framework (MAIF).',
    techStack: ['SAP S/4HANA', 'ECC EHP8', 'ABAP', 'RFC/BAPI', 'MAIF', 'SAP CAPM'],
    highlights: [
      'Developed high-performance OData services via SEGW and Mobile Application Integration Framework (MAIF)',
      'Engineered complex ABAP BAdI extensions and User Exits across SAP PM, WCM, PS, and IS-Utilities',
      'Modernized legacy RFC/BAPI layers to align with SAP S/4HANA Clean Core architectural governance',
    ],
  },
  {
    id: 'field-extensions-gis-wcm',
    icon: MapPin,
    title: 'Specialized Field Extensions (GIS, Dynamic Forms, WCM)',
    domain: 'Field Safety, Spatial & Digital Forms',
    focus: 'Field workforce enablement via SAP GEF/Esri GIS location tracking, Mirata Forms & SAP Dynamic Forms integration, Linear Asset Management (LAM), and Work Clearance Management safety protocols.',
    techStack: ['SAP GEF/GIS', 'SAP Dynamic Forms', 'Mirata Forms', 'LAM', 'WCM', 'Work Zone'],
    highlights: [
      'Integrated SAP GEF and Esri GIS feature layers for high-precision asset visualization in remote terrain',
      'Orchestrated Mirata Forms and SAP Dynamic Forms for mandatory field safety inspections and JSA compliance',
      'Automated Work Clearance Management (WCM) isolation tagouts, lockout verifications, and approvals',
    ],
  },
  {
    id: 'legacy-migration-modernization',
    icon: RefreshCw,
    title: 'Legacy Migration & Platform Modernization',
    domain: 'Agentry to SAP BTP Migration',
    focus: 'De-risking migrations from legacy Syclo-Agentry platforms (SAP Work Manager 6.0–6.2.1, Inventory Manager 4.2, SMP 3.0) to modern BTP-driven SSAM on S/4HANA.',
    techStack: ['Syclo-Agentry', 'Java/Spring', 'SMP 3.0 SDK', 'Retrofitting', 'Migration Strategy'],
    highlights: [
      'De-risked multi-phase migrations from legacy SAP Work Manager 6.0–6.2.1 to SSAM on S/4HANA',
      'Refactored custom Syclo Java/Spring data objects and open-search fetch logic into standard MDK metadata',
      'Guaranteed zero field data loss during transitional dual-run cutover phases across 15,000+ mobile devices',
    ],
  },
];
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
  {capabilities.map((cap) => {
    const IconComponent = cap.icon;
    return (
      <div 
        class="card-surface card-glow-hover rounded-2xl p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden group border border-zinc-800/80 bg-zinc-900/40"
      >
        <!-- Top Ambient Corner Glow on Hover -->
        <div class="absolute -top-12 -right-12 w-28 h-28 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all duration-300 pointer-events-none"></div>

        <div>
          <!-- Card Header with Icon & Domain Tag -->
          <div class="flex items-start justify-between gap-4 mb-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-zinc-950 border border-zinc-700/80 text-emerald-400 group-hover:border-emerald-500/60 group-hover:text-emerald-300 shadow-sm transition-all duration-200">
              <IconComponent class="w-6 h-6" />
            </div>
            <span class="text-[11px] font-mono uppercase tracking-wider px-2.5 py-1 rounded-full bg-zinc-800/70 border border-zinc-700/60 text-zinc-300">
              {cap.domain}
            </span>
          </div>

          <!-- Title -->
          <h3 class="text-xl font-bold tracking-tight text-zinc-100 group-hover:text-white transition-colors mb-2">
            {cap.title}
          </h3>

          <!-- Focus -->
          <p class="text-sm text-zinc-400 leading-relaxed mb-5">
            {cap.focus}
          </p>

          <!-- Tech Stack Pills -->
          <div class="mb-6">
            <div class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 mb-2">Technology Stack</div>
            <div class="flex flex-wrap gap-1.5">
              {cap.techStack.map((tech) => (
                <span class="tech-pill">{tech}</span>
              ))}
            </div>
          </div>

          <!-- Architectural Highlights -->
          <div class="space-y-2 mb-6">
            <div class="text-[11px] font-mono uppercase tracking-wider text-zinc-500">Production Execution Highlights</div>
            <ul class="space-y-1.5">
              {cap.highlights.map((h) => (
                <li class="flex items-start gap-2 text-xs text-zinc-300 leading-normal">
                  <span class="text-emerald-400 font-bold mt-0.5">›</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Action Link -->
        <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between">
          <a 
            href={`/capabilities#${cap.id}`}
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 hover:text-emerald-300 transition-colors group/link"
          >
            <span>Examine technical architecture</span>
            <ArrowRight class="w-3.5 h-3.5 group-hover/link:translate-x-1 transition-transform" />
          </a>
          <span class="text-[11px] font-mono text-zinc-500">Enterprise-Vetted</span>
        </div>
      </div>
    );
  })}
</div>
