---
import { Linkedin, Github, Rss, Award, ShieldCheck, ExternalLink } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-zinc-200 dark:border-zinc-800/80 bg-zinc-100/70 dark:bg-zinc-950/80 backdrop-blur-md mt-auto py-12 transition-colors">
  <div class="container mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1: Bio / Brand -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-zinc-200 dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700/80 shadow-inner">
            <span class="font-mono text-[11px] font-bold text-emerald-600 dark:text-emerald-400">SK</span>
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-sm text-zinc-900 dark:text-zinc-100">Sabarish Kamaraju</span>
            <span class="text-[10px] font-mono text-emerald-600 dark:text-emerald-400">Enterprise Mobility Architect | SAP BTP &amp; SSAM Specialist</span>
          </div>
        </div>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 max-w-md leading-relaxed">
          13+ years architecting mission-critical field workforce mobile solutions, S/4HANA migrations, and offline-first mobile applications across major global energy, utility, and pharma enterprises.
        </p>
        <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
          <span>SAP SSAM 2505</span>
          <span>•</span>
          <span>SAP BTP Mobile</span>
          <span>•</span>
          <span>S/4HANA EAM (PM/WCM)</span>
          <span>•</span>
          <span>Offline OData</span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="space-y-2.5">
        <div class="text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 font-semibold">Directory</div>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/" data-astro-prefetch="hover" class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Home</a>
          </li>
          <li>
            <a href="/capabilities" data-astro-prefetch="hover" class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Capabilities &amp; Architecture</a>
          </li>
          <li>
            <a href="/blog" data-astro-prefetch="hover" class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Field Architecture Blog</a>
          </li>
          <li>
            <a href="/contact" data-astro-prefetch="hover" class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Advisory &amp; Inquiries</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Verified Badges & Network -->
      <div class="space-y-2.5">
        <div class="text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 font-semibold">Certifications &amp; Network</div>
        <div class="flex flex-col space-y-2 text-xs">
          <a
            href="https://www.credly.com/badges/c0bdd6e0-8510-490a-a778-796466214a8c"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Credly SAP Solution Architect Badge"
            class="inline-flex items-center gap-2 text-zinc-600 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors group"
            title="Verify SAP Solution Architect on Credly"
          >
            <Award class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
            <span>SAP Certified Solution Architect (BTP)</span>
            <ExternalLink class="w-2.5 h-2.5 opacity-60 group-hover:opacity-100" />
          </a>
          <a
            href="https://www.credly.com/badges/d3adcc74-a03e-42a3-a681-6e7882ec088e"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Credly SAP Build Associate Badge"
            class="inline-flex items-center gap-2 text-zinc-600 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors group"
            title="Verify SAP Build Associate on Credly"
          >
            <ShieldCheck class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
            <span>SAP Certified Associate (SAP Build)</span>
            <ExternalLink class="w-2.5 h-2.5 opacity-60 group-hover:opacity-100" />
          </a>
          <a
            href="https://www.linkedin.com/in/sabarish-k-6b979918/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn Profile"
            class="inline-flex items-center gap-2 text-zinc-600 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors group"
            title="Connect on LinkedIn"
          >
            <Linkedin class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
            <span>LinkedIn Profile</span>
            <ExternalLink class="w-2.5 h-2.5 opacity-60 group-hover:opacity-100" />
          </a>
          <a
            href="https://github.com/sabari1004"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub Profile"
            class="inline-flex items-center gap-2 text-zinc-600 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors group"
            title="GitHub Architecture Repositories"
          >
            <Github class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
            <span>GitHub (@sabari1004)</span>
            <ExternalLink class="w-2.5 h-2.5 opacity-60 group-hover:opacity-100" />
          </a>
          <a
            href="/rss.xml"
            class="inline-flex items-center gap-2 text-zinc-600 dark:text-zinc-400 hover:text-amber-600 dark:hover:text-amber-400 transition-colors"
            title="Subscribe via RSS"
            aria-label="RSS Feed"
          >
            <Rss class="w-3.5 h-3.5" />
            <span>RSS Feed (/rss.xml)</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-zinc-200 dark:border-zinc-800/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-500">
      <div>
        © {currentYear} Sabarish Kamaraju. All rights reserved. Deployed to GitHub Pages.
      </div>
      <div class="flex items-center gap-4 text-[11px]">
        <span class="text-zinc-600 dark:text-zinc-400">sabarishk.com</span>
        <span>•</span>
        <span class="text-zinc-500">Utilities, Energy &amp; Pharma EAM Mobility</span>
      </div>
    </div>
  </div>
</footer>
