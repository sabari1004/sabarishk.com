---
import { Menu, X, ArrowUpRight, Linkedin, Github } from 'lucide-astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// Normalize path for matching active links
const normalizedPath = currentPath.endsWith('/') && currentPath.length > 1 
  ? currentPath.slice(0, -1) 
  : currentPath;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/capabilities', label: 'Capabilities' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];

const isActive = (href: string) => {
  if (href === '/') return normalizedPath === '/' || normalizedPath === '';
  return normalizedPath.startsWith(href);
};
---

<header id="site-header" class="sticky top-0 z-50 w-full backdrop-blur-xl bg-zinc-950/80 border-b border-zinc-800/80 transition-colors" style="view-transition-name: site-header;">
  <div class="container mx-auto flex h-16 items-center justify-between px-4 sm:px-6">
    <!-- Brand Monogram & Title -->
    <a href="/" data-astro-prefetch="hover" class="group flex items-center gap-3 transition-transform focus:outline-none">
      <div class="relative flex h-9 w-9 items-center justify-center rounded-lg bg-zinc-900 border border-zinc-700/80 shadow-inner group-hover:border-emerald-500/60 group-hover:shadow-[0_0_12px_rgba(16,185,129,0.3)] transition-all">
        <span class="font-mono text-xs font-bold tracking-tight text-emerald-400 group-hover:text-emerald-300">SK</span>
        <div class="absolute -bottom-0.5 -right-0.5 h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></div>
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-semibold tracking-tight text-zinc-100 group-hover:text-white transition-colors">
          Sabarish Kamaraju
        </span>
        <span class="text-[11px] font-mono text-zinc-400 tracking-wide">
          Enterprise Mobility Architect
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1.5 rounded-full bg-zinc-900/70 p-1.5 border border-zinc-800/80 backdrop-blur-md">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            data-astro-prefetch="hover"
            class:list={[
              'relative px-3.5 py-1.5 text-xs font-medium rounded-full transition-all duration-150 focus:outline-none',
              active
                ? 'bg-zinc-800/90 text-white font-semibold border border-zinc-700/80 shadow-sm'
                : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/40'
            ]}
          >
            {link.label}
            {active && (
              <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-3 h-0.5 bg-emerald-400 rounded-full" />
            )}
          </a>
        );
      })}
    </nav>

    <!-- Desktop Actions / Social & Contact CTA -->
    <div class="hidden md:flex items-center gap-2.5">
      <div class="flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-950/40 border border-emerald-800/50 text-[11px] font-mono text-emerald-400 mr-1">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-ping"></span>
        <span>Advising Utilities &amp; EAM</span>
      </div>

      <!-- Verified LinkedIn Button with Hover Glow -->
      <a
        href="https://www.linkedin.com/in/sabarish-k-6b979918/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn Profile"
        class="p-2 rounded-lg bg-zinc-900 border border-zinc-700/80 text-zinc-400 hover:text-emerald-400 hover:border-emerald-500/50 hover:shadow-[0_0_12px_rgba(16,185,129,0.3)] transition-all focus:outline-none"
        title="LinkedIn Profile"
      >
        <Linkedin class="w-4 h-4" />
      </a>

      <!-- GitHub Button -->
      <a
        href="https://github.com/sabari1004"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="p-2 rounded-lg bg-zinc-900 border border-zinc-700/80 text-zinc-400 hover:text-emerald-400 hover:border-emerald-500/50 hover:shadow-[0_0_12px_rgba(16,185,129,0.3)] transition-all focus:outline-none"
        title="GitHub Profile"
      >
        <Github class="w-4 h-4" />
      </a>

      <!-- Connect CTA -->
      <a
        href="/contact"
        data-astro-prefetch="hover"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-medium text-zinc-200 rounded-lg bg-zinc-900 border border-zinc-700/80 hover:border-emerald-500/50 hover:text-white hover:shadow-[0_0_15px_rgba(16,185,129,0.2)] transition-all ml-1"
      >
        <span>Connect</span>
        <ArrowUpRight class="w-3.5 h-3.5 text-emerald-400" />
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button
      id="mobile-nav-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      class="flex md:hidden p-2 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-white hover:border-zinc-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
    >
      <Menu id="menu-icon-open" class="w-5 h-5 block" />
      <X id="menu-icon-close" class="w-5 h-5 hidden" />
    </button>
  </div>

  <!-- Mobile Drawer Overlay -->
  <div
    id="mobile-nav-drawer"
    class="fixed inset-x-0 top-16 z-40 hidden border-b border-zinc-800 bg-zinc-950/95 backdrop-blur-2xl px-6 py-6 transition-all duration-300 md:hidden"
  >
    <div class="flex flex-col space-y-3">
      <div class="flex items-center justify-between pb-3 border-b border-zinc-800/80">
        <span class="text-xs font-mono uppercase tracking-widest text-zinc-500">Navigation</span>
        <div class="flex items-center gap-1.5 text-[11px] font-mono text-emerald-400">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          <span>Advising Utilities</span>
        </div>
      </div>
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            data-astro-prefetch="hover"
            class:list={[
              'flex items-center justify-between py-2 px-3 rounded-lg text-sm font-medium transition-colors',
              active
                ? 'bg-zinc-900 text-emerald-400 font-semibold border border-zinc-800'
                : 'text-zinc-300 hover:bg-zinc-900/60 hover:text-white'
            ]}
          >
            <span>{link.label}</span>
            {active && <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>}
          </a>
        );
      })}
      
      <!-- Mobile Social Channels -->
      <div class="pt-3 border-t border-zinc-800/80 flex items-center justify-between">
        <span class="text-xs font-mono text-zinc-400">Profiles:</span>
        <div class="flex items-center gap-3">
          <a
            href="https://www.linkedin.com/in/sabarish-k-6b979918/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 text-xs text-zinc-300 hover:text-emerald-400"
          >
            <Linkedin class="w-4 h-4 text-emerald-400" />
            <span>LinkedIn</span>
          </a>
          <a
            href="https://github.com/sabari1004"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 text-xs text-zinc-300 hover:text-emerald-400"
          >
            <Github class="w-4 h-4 text-emerald-400" />
            <span>GitHub</span>
          </a>
        </div>
      </div>

      <div class="pt-2 flex flex-col gap-2">
        <a
          href="/contact"
          data-astro-prefetch="hover"
          class="flex items-center justify-center gap-2 w-full py-2.5 text-xs font-semibold rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white shadow-[0_0_15px_rgba(16,185,129,0.3)] transition-all"
        >
          <span>Schedule Architecture Consultation</span>
          <ArrowUpRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileNav() {
    const toggle = document.getElementById('mobile-nav-toggle');
    const drawer = document.getElementById('mobile-nav-drawer');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');

    if (!toggle || !drawer) return;

    toggle.onclick = () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', (!isExpanded).toString());
      drawer.classList.toggle('hidden');
      if (openIcon && closeIcon) {
        openIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      }
    };

    // Close on link click
    const drawerLinks = drawer.querySelectorAll('a');
    drawerLinks.forEach((link) => {
      link.onclick = () => {
        drawer.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        if (openIcon && closeIcon) {
          openIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        }
      };
    });
  }

  // Idempotent page-load execution
  document.addEventListener('astro:page-load', setupMobileNav);
</script>
