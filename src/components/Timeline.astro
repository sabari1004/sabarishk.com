---
import { CheckCircle2, Building2 } from './icons';

export interface MilestoneProgram {
  id: string;
  period: string;
  role: string;
  organization: string;
  clients: string[];
  scope: string;
  deliverables: string[];
  techStack: string[];
}

const programs: MilestoneProgram[] = [
  {
    id: 'program-us-utilities',
    period: '2024 — Present',
    role: 'Principal Enterprise Solutions Architect & SSAM Lead',
    organization: 'Enterprise Mobility Advisory & Consulting',
    clients: [
      'California Electric & Gas Utility',
      'Southern California Power Utility',
      'Global Clean Energy Operator',
      'Midwest Electric & Gas Utility',
      'Municipal Power Authority',
      'North American Energy Producer'
    ],
    scope: 'Directing architectural strategy for next-generation SSAM 2410 and 2505 upgrades, enterprise SAP EAM Phase Model governance, Multi-Resource Scheduling (MRS) / Resource Scheduling (RSH) dispatch interlock, and mission-critical SMP-to-BTP Mobile Services cloud migrations for top-tier US power, gas, and energy utilities.',
    deliverables: [
      'Architected SSAM 2410/2505 migration paths, preserving custom client extensions and multi-tier offline OData caches for 15,000+ field utility workers.',
      'Implemented S/4HANA EAM Phase Model control gates and Resource Scheduling (RSH/MRS) interlocks, preventing unapproved work from hitting field technician mobile queues prematurely.',
      'Configured bidirectional synchronization between RSH Maintenance Scheduling Boards and SSAM mobile execution states, updating phase transitions in real time.',
      'Designed end-to-end integration architecture for Mirata Forms and SAP Dynamic Forms, automating Job Safety Analyses (JSA) and EHS regulatory compliance.',
      'Led SMP 3.0 on-premise decommissioning to SAP BTP Mobile Services on Cloud Foundry, reducing infrastructure maintenance overhead by 45%.',
    ],
    techStack: ['SSAM 2505', 'SAP EAM Phase Model', 'SAP RSH', 'SAP MRS', 'SAP BTP Mobile', 'MDK', 'SAP Dynamic Forms', 'S/4HANA EAM', 'Esri GIS'],
  },
  {
    id: 'program-lan-pharma',
    period: '2024',
    role: 'Senior Mobility Solutions Consultant',
    organization: 'Enterprise Mobility Practice',
    clients: ['Multinational Life Sciences & Pharma Enterprise', 'Global Healthcare Manufacturer'],
    scope: 'Led SSAM 2405 BTP Cloud Foundry enterprise rollouts, Swiss Pharma GxP-compliant asset management upgrades (SSAM 2205 -> 2305), and custom MDK client packaging for highly regulated manufacturing facilities.',
    deliverables: [
      'Supervised SSAM 2205 to 2305 upgrade across validated GxP environments, ensuring 21 CFR Part 11 electronic signature audit compliance.',
      'Built custom native MDK plugins and branded container packages for ruggedized barcode scanners and intrinsically safe mobile tablets.',
      'Implemented offline data delta synchronization tuning across 24 high-volume defining requests, cutting mobile sync cycle times under 2 seconds.',
    ],
    techStack: ['SSAM 2405', 'SAP BTP Mobile Services', 'MDK Native', 'Offline OData', 'GxP Compliance', 'Custom Client Branding'],
  },
  {
    id: 'program-wipro-modernization',
    period: '2022 — 2024',
    role: 'Lead SAP Mobility Architect',
    organization: 'Wipro Technologies',
    clients: ['UK Water & Electric Utilities', 'Global Energy Leaders'],
    scope: 'Orchestrated massive modernization programs transitioning legacy Syclo-Agentry platforms to SAP S/4HANA across Plant Maintenance (PM), Multi-Resource Scheduling (MRS), Project Systems (PS), CRM, and Work Clearance Management (WCM).',
    deliverables: [
      'Modernized UK Utility operations through SSAM 2210 rollout with Linear Asset Management (LAM) and GIS pipeline visualization.',
      'Integrated SAP Multi-Resource Scheduling (MRS) resource planning with mobile dispatch, aligning technician qualifications and tool tracking with field service work orders.',
      'Designed dual-run data reconciliation adapters enabling field technicians to transition seamlessly from legacy Syclo Work Manager to MDK SSAM.',
      'Engineered backend ABAP BAdIs, custom BAPIs, and MAIF OData service endpoints for complex field service orders and WCM isolation tagouts.',
    ],
    techStack: ['Syclo-Agentry', 'SAP Work Manager 6.2', 'SAP S/4HANA', 'SSAM 2210', 'SAP MRS', 'ABAP MAIF', 'WCM', 'Linear Asset Management'],
  },
  {
    id: 'program-earlier-foundations',
    period: '2012 — 2022',
    role: 'Senior SAP Mobility & Integration Engineer',
    organization: 'L&T Infotech (LTIMindtree) • Future Focus • IBM',
    clients: ['Global Oil & Gas', 'Discrete Manufacturing', 'Infrastructure Enterprises'],
    scope: 'Delivered foundational Greenfield Agentry field mobility solutions, SMP 3.0 architectures, custom Java/Spring backend business logic, and core SAP PM/MM mobile integration tooling.',
    deliverables: [
      'Architected and implemented Greenfield Syclo Agentry solutions (SAP Work Manager 6.0/6.1, Inventory Manager 4.2) for oil refineries and offshore platforms.',
      'Engineered high-throughput Java OpenSearch fetch rules and complex transaction stepping for SAP NetWeaver and ECC backends.',
      'Mentored and cross-trained enterprise mobility squads during the industry-wide evolution from on-prem SMP 3.0 to modern SAP BTP Cloud.',
    ],
    techStack: ['Syclo Agentry', 'SAP Work Manager 6.0', 'SMP 3.0 SDK', 'Java / Spring', 'SAP ECC EHP7/8', 'Plant Maintenance'],
  },
];
---

<div class="relative border-l border-zinc-200 dark:border-zinc-800/80 ml-4 sm:ml-6 space-y-12 py-4">
  {programs.map((prog) => (
    <div class="relative pl-6 sm:pl-8 group">
      <!-- Pulsing Node Anchor on the vertical line -->
      <div class="absolute -left-[9px] top-1.5 h-4 w-4 rounded-full bg-white dark:bg-zinc-950 border-2 border-zinc-300 dark:border-zinc-700 group-hover:border-emerald-500 dark:group-hover:border-emerald-400 group-hover:bg-emerald-500/20 transition-all duration-300 flex items-center justify-center">
        <span class="h-1.5 w-1.5 rounded-full bg-zinc-400 dark:bg-zinc-400 group-hover:bg-emerald-500 dark:group-hover:bg-emerald-400 transition-colors"></span>
      </div>

      <!-- Milestone Card -->
      <div class="card-surface rounded-xl p-5 sm:p-7 border border-zinc-200 dark:border-zinc-800/80 bg-white/80 dark:bg-zinc-900/30 group-hover:border-zinc-300 dark:group-hover:border-zinc-700/80 shadow-sm dark:shadow-none transition-all">
        <!-- Header: Period & Role -->
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-4">
          <div>
            <div class="flex items-center gap-2 mb-1.5">
              <span class="text-xs font-mono font-semibold text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/50 px-2.5 py-0.5 rounded-md inline-block">
                {prog.period}
              </span>
              <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
                {prog.organization}
              </span>
            </div>
            <h4 class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-white transition-colors">
              {prog.role}
            </h4>
          </div>
        </div>

        <!-- Client & Program Badges Strip -->
        <div class="mb-4 p-3 rounded-lg bg-zinc-50 dark:bg-zinc-950/70 border border-zinc-200 dark:border-zinc-800/70">
          <div class="text-[10px] font-mono uppercase tracking-wider text-zinc-500 mb-1.5 font-semibold">
            Key Enterprise Programs &amp; Clients
          </div>
          <div class="flex flex-wrap gap-1.5">
            {prog.clients.map((client) => (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-white dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/60 text-[11px] font-mono text-emerald-700 dark:text-emerald-300 shadow-xs">
                <Building2 class="w-2.5 h-2.5 text-emerald-600 dark:text-emerald-400" />
                <span>{client}</span>
              </span>
            ))}
          </div>
        </div>

        <!-- Scope Overview -->
        <p class="text-xs sm:text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed mb-4">
          {prog.scope}
        </p>

        <!-- Deliverables -->
        <div class="space-y-2 mb-5">
          <div class="text-[11px] font-mono uppercase tracking-wider text-zinc-500 font-semibold">
            Key Architectural Deliverables
          </div>
          <div class="space-y-2">
            {prog.deliverables.map((deliv) => (
              <div class="flex items-start gap-2.5 text-xs text-zinc-700 dark:text-zinc-300 leading-relaxed">
                <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 mt-0.5 shrink-0" />
                <span>{deliv}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Tech tags -->
        <div class="flex flex-wrap gap-1.5 pt-3 border-t border-zinc-200 dark:border-zinc-800/60">
          {prog.techStack.map((t) => (
            <span class="tech-pill text-[10px]">{t}</span>
          ))}
        </div>
      </div>
    </div>
  ))}
</div>
